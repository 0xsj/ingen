{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ingen.example/spec/ingen.replay-matrix-v1.schema.json",
  "title": "Sorna replay matrix report",
  "description": "Expected-classification aggregate for producer-owned behavioral replay CI results.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "total", "matched", "mismatched", "entries"],
  "properties": {
    "schema": {"const": "sorna.replay-matrix/v1"},
    "status": {"enum": ["passed", "failed"]},
    "total": {"type": "integer", "minimum": 1},
    "matched": {"type": "integer", "minimum": 0},
    "mismatched": {"type": "integer", "minimum": 0},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "input_sha256",
        "expected_ci_status",
        "actual_ci_status",
        "expected_replay_state",
        "actual_replay_state",
        "contract_id",
        "recorded_run_id",
        "replay_run_id",
        "status"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "expected_ci_status": {"enum": ["passed", "failed", "error"]},
        "actual_ci_status": {"enum": ["passed", "failed", "error"]},
        "expected_replay_state": {"enum": ["matched", "drifted", "error", "inconclusive"]},
        "actual_replay_state": {"enum": ["matched", "drifted", "error", "inconclusive"]},
        "contract_id": {"type": "string", "minLength": 1},
        "recorded_run_id": {"type": "string", "minLength": 1},
        "replay_run_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["matched", "mismatched"]},
        "differences": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
