{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ingen.example/spec/ingen.policy-v1.schema.json",
  "title": "InGen Sorna capability policy",
  "description": "The language-neutral capability declaration consumed by Sorna.",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy"],
  "properties": {
    "policy": {"$ref": "#/$defs/policy"}
  },
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "id", "version", "status", "purpose", "enforcement", "filesystem", "network", "process"],
      "properties": {
        "schema": {"const": "ingen.policy/v1"},
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "integer", "minimum": 1},
        "status": {"enum": ["draft", "sealed", "superseded"]},
        "purpose": {"type": "string", "minLength": 1},
        "enforcement": {"enum": ["declared-only", "host-enforced", "externally-attested"]},
        "filesystem": {"$ref": "#/$defs/filesystem"},
        "network": {"$ref": "#/$defs/network"},
        "process": {"$ref": "#/$defs/process"}
      }
    },
    "filesystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read", "write", "deny"],
      "properties": {
        "read": {"type": "array", "items": {"$ref": "#/$defs/path-rule"}},
        "write": {"type": "array", "items": {"$ref": "#/$defs/path-rule"}},
        "deny": {"type": "array", "items": {"$ref": "#/$defs/path-rule"}}
      }
    },
    "path-rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "reason"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["disabled", "allowlist", "unrestricted"]},
        "allow": {
          "type": "array",
          "items": {"$ref": "#/$defs/network-rule"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "allowlist"}}, "required": ["mode"]},
          "then": {"required": ["allow"], "properties": {"allow": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"mode": {"enum": ["disabled", "unrestricted"]}}, "required": ["mode"]},
          "then": {"not": {"required": ["allow"]}}
        }
      ]
    },
    "network-rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "ports", "purpose"],
      "properties": {
        "host": {"type": "string", "minLength": 1},
        "ports": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "integer", "minimum": 1, "maximum": 65535}
        },
        "direction": {"enum": ["inbound", "outbound", "both"]},
        "purpose": {"type": "string", "minLength": 1}
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_id", "can_invoke_subject"],
      "properties": {
        "subject_id": {"type": "string", "minLength": 1},
        "can_invoke_subject": {"type": "boolean"},
        "allowed_tools": {
          "type": "array",
          "items": {"$ref": "#/$defs/tool"}
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "purpose"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1}
      }
    }
  }
}
