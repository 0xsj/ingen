{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ingen.dev/schema/sorna.release-verification-v1.schema.json",
  "title": "Sorna release verification result",
  "description": "The machine-readable result of verifying every archive named by a Sorna release manifest.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "manifest", "directory", "version", "artifacts"],
  "properties": {
    "schema": {"const": "sorna.release-verification/v1"},
    "status": {"enum": ["passed", "failed"]},
    "manifest": {"type": "string", "minLength": 1},
    "directory": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifact_result"}
    }
  },
  "$defs": {
    "artifact_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "expected_sha256", "status"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "expected_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "actual_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "status": {"enum": ["passed", "failed"]},
        "error": {"type": "string", "minLength": 1}
      }
    }
  }
}
