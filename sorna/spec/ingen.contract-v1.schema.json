{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ingen.example/spec/ingen.contract-v1.schema.json",
  "title": "InGen behavioral contract",
  "description": "The language-neutral contract source consumed by Sorna.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract"],
  "properties": {
    "contract": {"$ref": "#/$defs/contract"}
  },
  "$defs": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "id", "version", "status", "interface", "rules", "unspecified"],
      "properties": {
        "schema": {"const": "ingen.contract/v1"},
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "integer", "minimum": 1},
        "status": {"enum": ["draft", "sealed", "superseded"]},
        "title": {"type": "string"},
        "summary": {"type": "string"},
        "owner": {"type": "string"},
        "interface": {"$ref": "#/$defs/interface"},
        "vocabulary": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "rules": {
          "type": "array",
          "items": {"$ref": "#/$defs/rule"}
        },
        "unspecified": {
          "type": "array",
          "items": {"type": "string"}
        },
        "fixtures": {
          "type": "array",
          "items": {"$ref": "#/$defs/fixture"}
        },
        "assumptions": {
          "type": "array",
          "items": {"type": "string"}
        },
        "amendments": {
          "type": "array",
          "items": {"type": "object"}
        },
        "tags": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "interface": {
      "type": "object",
      "additionalProperties": true,
      "required": ["kind"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "base_url": {"type": "string", "minLength": 1},
        "adapter": {"type": "string", "minLength": 1},
        "public_entrypoints": {
          "type": "array",
          "items": {"$ref": "#/$defs/entrypoint"}
        }
      }
    },
    "entrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "path": {"type": "string", "pattern": "^/"}
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "strength"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "strength": {"enum": ["must", "must_not", "may", "should", "unspecified"]},
        "subject": {"type": "string", "minLength": 1},
        "tags": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "given": {"type": "object"},
        "when": {"type": "object"},
        "expect": {"$ref": "#/$defs/expectation"},
        "invariant": {"type": "string", "minLength": 1},
        "rationale": {"type": "string"}
      }
    },
    "expectation": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "status": {"type": "integer", "minimum": 100, "maximum": 599},
        "headers": {"type": "object"},
        "body": {"type": "object"},
        "error": {"type": "object"},
        "events": {"$ref": "#/$defs/events"},
        "subsequent": {"type": "array"}
      }
    },
    "events": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required"],
      "properties": {
        "required": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "id": {"type": "string", "minLength": 1},
        "owner": {"enum": ["oracle", "subject"]},
        "purpose": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
