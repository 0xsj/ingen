{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ingen.example/spec/ingen.fixture-handoff-v1.schema.json",
  "title": "InGen verified fixture handoff",
  "description": "The verified relationship between a sealed contract and provider-supplied oracle fixture files.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "contract", "provider", "fixtures"],
  "properties": {
    "schema": {"const": "ingen.fixture-handoff/v1"},
    "status": {"const": "verified"},
    "contract": {"$ref": "#/$defs/contract_reference"},
    "provider": {"$ref": "#/$defs/provider_reference"},
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/fixture"}
    }
  },
  "$defs": {
    "contract_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "provider_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256", "bytes"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 0}
      }
    }
  }
}
