{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ingen.dev/schema/ingen.mutation-preparation-v1.schema.json",
  "title": "InGen mutation preparation summary",
  "description": "Language-neutral source and executable preparation evidence for a Sorna mutation campaign.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "provider_id", "plan_path", "plan_sha256", "variants"],
  "properties": {
    "schema": {"const": "ingen.mutation-preparation/v1"},
    "provider_id": {"type": "string", "minLength": 1},
    "plan_path": {"type": "string", "minLength": 1},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "plan_semantic_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/variant"}
    }
  },
  "$defs": {
    "preparation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "provider_id", "plan_path", "plan_sha256", "variants"],
      "properties": {
        "schema": {"const": "ingen.mutation-preparation/v1"},
        "provider_id": {"type": "string", "minLength": 1},
        "plan_path": {"type": "string", "minLength": 1},
        "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "plan_semantic_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/variant"}
        }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "mutation_id", "source_dir", "source_sha256", "binary_path", "binary_sha256", "changed_files", "provenance"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "mutation_id": {"type": "string", "minLength": 1},
        "source_dir": {"type": "string", "minLength": 1},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "binary_path": {"type": "string", "minLength": 1},
        "binary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "changed_files": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_dir", "source_sha256", "binary_sha256", "location", "before", "after"],
      "properties": {
        "source_dir": {"type": "string", "minLength": 1},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "binary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "location": {"type": "string", "minLength": 1},
        "before": {"type": "string", "minLength": 1},
        "after": {"type": "string", "minLength": 1},
        "target_resolution": {"$ref": "#/$defs/target_resolution"}
      }
    },
    "target_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector", "candidate_count", "applied_count"],
      "properties": {
        "selector": {"type": "string", "minLength": 1},
        "candidate_count": {"type": "integer", "minimum": 0},
        "applied_count": {"type": "integer", "minimum": 0}
      }
    }
  }
}
