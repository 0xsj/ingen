{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ingen.example/spec/ingen.mutation-campaign-result-v1.schema.json",
  "title": "InGen Sorna mutation campaign result",
  "description": "The language-neutral aggregate result of executing a frozen mutation campaign.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "plan", "started_at", "finished_at", "summary", "entries"],
  "properties": {
    "schema": {"const": "ingen.mutation-campaign-result/v1"},
    "status": {"enum": ["passed", "failed", "error"]},
    "plan": {"$ref": "#/$defs/plan"},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "summary": {"$ref": "#/$defs/summary"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "semantic_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_sha256", "checksums_sha256"],
      "properties": {
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "checksums_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "mutation_id", "evidence_path", "status", "exit_code"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "mutation_id": {"type": "string", "minLength": 1},
        "evidence_path": {"type": "string", "minLength": 1},
        "evidence": {"$ref": "#/$defs/evidence"},
        "run_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["passed", "failed", "error"]},
        "outcome": {"type": "string", "minLength": 1},
        "exit_code": {"type": "integer"},
        "reason": {"type": "string"},
        "diagnosis": {"$ref": "#/$defs/diagnosis"}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "killed", "survived", "inconclusive", "other", "errors"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "killed": {"type": "integer", "minimum": 0},
        "survived": {"type": "integer", "minimum": 0},
        "inconclusive": {"type": "integer", "minimum": 0},
        "other": {"type": "integer", "minimum": 0},
        "errors": {"type": "integer", "minimum": 0}
      }
    },
    "diagnosis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expected_rule_status": {
          "type": "object",
          "additionalProperties": {
            "enum": ["pass", "fail", "inconclusive", "error", "skipped", "unobserved"]
          }
        },
        "directly_failed_rules": {"type": "array", "items": {"type": "string"}},
        "cascading_inconclusive": {"type": "array", "items": {"type": "string"}},
        "unaffected_rules": {"type": "array", "items": {"type": "string"}},
        "unobserved_expected": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
