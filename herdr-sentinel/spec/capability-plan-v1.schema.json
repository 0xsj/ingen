{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ingen.example/spec/ingen.sentinel-capability-plan-v1.schema.json",
  "title": "InGen Sentinel capability plan v1",
  "description": "A derived, declaration-only capability handoff for a Sentinel workspace.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "workspace", "implementation_roots", "enforcement", "assurance", "roles"],
  "properties": {
    "schema": {"const": "ingen.sentinel-capability-plan/v1"},
    "workspace": {"$ref": "#/$defs/workspace-ref"},
    "implementation_roots": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "enforcement": {"const": "declaration-only"},
    "assurance": {"const": "unverified"},
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/role"}
    }
  },
  "$defs": {
    "file-ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "workspace-ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "manifest", "oracle_policy", "subject_policy"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "integer", "minimum": 1},
        "manifest": {"$ref": "#/$defs/file-ref"},
        "oracle_policy": {"$ref": "#/$defs/file-ref"},
        "subject_policy": {"$ref": "#/$defs/file-ref"}
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "workspace", "read_roots", "write_roots", "deny_roots"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "workspace": {"type": "string", "minLength": 1},
        "read_roots": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "write_roots": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "deny_roots": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
