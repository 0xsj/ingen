{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ingen.dev/schemas/sentinel/role-execution-v1.schema.json",
  "title": "Sentinel role execution report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "execution_id", "workspace_id", "role_id", "role_kind",
    "manifest_sha256", "policy_sha256", "workspace_manifest_path", "policy_path", "executable_path", "executable_sha256",
    "allowed_tools", "allowed_tool_sha256", "backend", "enforcement", "assurance",
    "enforcement_scope", "limitations", "network_mode", "declared_read_roots",
    "declared_write_roots", "declared_deny_roots", "derived_read_roots", "derived_write_roots",
    "stdout_path", "stderr_path", "started_at", "finished_at", "status"
  ],
  "properties": {
    "schema": { "const": "ingen.sentinel-role-execution/v1" },
    "execution_id": { "type": "string", "minLength": 1 },
    "workspace_id": { "type": "string", "minLength": 1 },
    "role_id": { "type": "string", "minLength": 1 },
    "role_kind": { "type": "string", "minLength": 1 },
    "manifest_sha256": { "$ref": "#/$defs/sha256" },
    "policy_sha256": { "$ref": "#/$defs/sha256" },
    "workspace_manifest_path": { "type": "string", "minLength": 1 },
    "policy_path": { "type": "string", "minLength": 1 },
    "executable_path": { "type": "string", "minLength": 1 },
    "executable_sha256": { "$ref": "#/$defs/sha256" },
    "allowed_tools": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "allowed_tool_sha256": { "type": "array", "items": { "$ref": "#/$defs/sha256" } },
    "backend": { "const": "macos-seatbelt" },
    "enforcement": { "const": "host-enforced" },
    "assurance": { "const": "unverified" },
    "enforcement_scope": { "type": "string", "minLength": 1 },
    "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "network_mode": { "const": "disabled" },
    "declared_read_roots": { "$ref": "#/$defs/paths" },
    "declared_write_roots": { "$ref": "#/$defs/paths" },
    "declared_deny_roots": { "$ref": "#/$defs/paths" },
    "derived_read_roots": { "$ref": "#/$defs/paths" },
    "derived_write_roots": { "$ref": "#/$defs/paths" },
    "stdout_path": { "type": "string", "minLength": 1 },
    "stdout_sha256": { "$ref": "#/$defs/sha256" },
    "stderr_path": { "type": "string", "minLength": 1 },
    "stderr_sha256": { "$ref": "#/$defs/sha256" },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["completed", "failed", "canceled", "indeterminate"] },
    "exit_code": { "type": "integer" },
    "reason": { "type": "string" },
    "governance": { "type": "object" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "paths": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
