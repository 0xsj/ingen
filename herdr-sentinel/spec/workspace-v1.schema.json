{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ingen.example/spec/sentinel-workspace-v1.schema.json",
  "title": "InGen Sentinel workspace v1",
  "type": "object",
  "required": ["sentinel_workspace"],
  "additionalProperties": false,
  "properties": {
    "sentinel_workspace": {
      "type": "object",
      "required": ["schema", "id", "version", "project_root", "contract", "implementation_roots", "sorna", "delivery", "roles"],
      "additionalProperties": false,
      "properties": {
        "schema": {"const": "ingen.sentinel-workspace/v1"},
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "integer", "minimum": 1},
        "project_root": {"type": "string", "minLength": 1},
        "contract": {
          "type": "object",
          "required": ["path"],
          "additionalProperties": false,
          "properties": {"path": {"type": "string", "minLength": 1}}
        },
        "implementation_roots": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
        "sorna": {
          "type": "object",
          "required": ["oracle_policy", "subject_policy"],
          "additionalProperties": false,
          "properties": {
            "oracle_policy": {"type": "string", "minLength": 1},
            "subject_policy": {"type": "string", "minLength": 1}
          }
        },
        "delivery": {
          "type": "object",
          "required": ["workflow"],
          "additionalProperties": false,
          "properties": {"workflow": {"type": "string", "minLength": 1}}
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "kind", "workspace", "read_roots", "write_roots", "deny_roots"],
            "additionalProperties": false,
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "kind": {"enum": ["contract-author", "oracle-writer", "implementation", "verifier", "mutation-runner"]},
              "workspace": {"type": "string", "minLength": 1},
              "read_roots": {"type": "array", "items": {"type": "string"}},
              "write_roots": {"type": "array", "items": {"type": "string"}},
              "deny_roots": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    }
  }
}
