{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ingen.herdr-signed-event-batch/v1",
  "title": "Operator signed event file batch; shared-key possession only",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "sender", "key_id", "run_id", "workspace_id", "workspace_version", "issued_at", "expires_at", "payload_sha256", "payload_base64", "hmac_sha256"],
  "properties": {
    "schema": {"const": "ingen.herdr-signed-event-batch/v1"},
    "sender": {"type": "string", "pattern": "^[A-Za-z0-9][-A-Za-z0-9._:@/]{0,127}$"},
    "key_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "run_id": {"type": "string", "minLength": 1},
    "workspace_id": {"type": "string", "minLength": 1},
    "workspace_version": {"type": "integer", "minimum": 1},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "payload_base64": {"type": "string", "minLength": 4, "maxLength": 5592408, "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"},
    "hmac_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
