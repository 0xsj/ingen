{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ingen.example/spec/ingen.sentinel-native-recovery-assessment-v1.schema.json",
  "title": "InGen Sentinel native recovery assessment v1",
  "description": "Read-only, time-bounded observations about one Sentinel native session. It is not a process, host, or recovery attestation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "assessed_at", "root", "journal_path", "journal_sha256", "snapshot_consistency", "session_id", "run_id", "workspace_id", "workspace_version", "state", "execution_lease", "receipt", "terminal_evidence", "recommended_action", "recommendation", "limitations"],
  "properties": {
    "schema": {"const": "ingen.sentinel-native-recovery-assessment/v1"},
    "status": {"enum": ["assessed", "uncertain"]},
    "assessed_at": {"type": "string", "format": "date-time"},
    "root": {"type": "string", "minLength": 1},
    "journal_path": {"type": "string", "minLength": 1},
    "journal_sha256": {"$ref": "#/$defs/sha256"},
    "snapshot_consistency": {"enum": ["stable", "changed"]},
    "session_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "workspace_id": {"type": "string", "minLength": 1},
    "workspace_version": {"type": "integer", "minimum": 1},
    "state": {"enum": ["prepared", "dispatching", "submitted", "running", "cancel-requested", "completed", "failed", "canceled", "indeterminate"]},
    "execution_lease": {"$ref": "#/$defs/lease"},
    "receipt": {"$ref": "#/$defs/receipt"},
    "terminal_evidence": {"$ref": "#/$defs/terminalEvidence"},
    "recommended_action": {"enum": ["reassess", "manual-review", "wait-and-reassess", "collect-or-close", "native-recover-review"]},
    "recommendation": {"type": "string", "minLength": 1},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "lease": {
      "type": "object", "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["held", "free", "missing", "unsupported", "uncertain", "not-probed"]},
        "path": {"type": "string", "minLength": 1},
        "detail": {"type": "string", "minLength": 1}
      }
    },
    "receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "path"],
      "properties": {
        "status": {"enum": ["matched", "mismatched", "missing", "uncertain"]},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "detail": {"type": "string", "minLength": 1}
      }
    },
    "terminalEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["not-terminal", "not-applicable", "matched", "drift", "missing", "uncertain"]},
        "stdout_path": {"type": "string", "minLength": 1},
        "stdout_sha256": {"$ref": "#/$defs/sha256"},
        "observed_stdout_sha256": {"$ref": "#/$defs/sha256"},
        "stderr_path": {"type": "string", "minLength": 1},
        "stderr_sha256": {"$ref": "#/$defs/sha256"},
        "observed_stderr_sha256": {"$ref": "#/$defs/sha256"},
        "detail": {"type": "string", "minLength": 1}
      }
    }
  }
}
