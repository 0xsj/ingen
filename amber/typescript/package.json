{
  "name": "@0xsj/amber",
  "version": "0.1.0",
  "description": "Portable application-level provenance for TypeScript",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xsj/ingen.git",
    "directory": "amber/typescript"
  },
  "homepage": "https://github.com/0xsj/ingen/tree/main/amber",
  "bugs": {
    "url": "https://github.com/0xsj/ingen/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/context.d.ts",
    "dist/context.js",
    "dist/http.d.ts",
    "dist/http.js",
    "dist/incoming.d.ts",
    "dist/incoming.js",
    "dist/index.d.ts",
    "dist/index.js",
    "dist/logging.d.ts",
    "dist/logging.js",
    "dist/messaging.d.ts",
    "dist/messaging.js",
    "dist/provenance.d.ts",
    "dist/provenance.js",
    "dist/storage.d.ts",
    "dist/storage.js",
    "dist/otel.d.ts",
    "dist/otel.js",
    "dist/tracing.d.ts",
    "dist/tracing.js",
    "dist/transport.d.ts",
    "dist/transport.js"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "example": "npm run build && node dist/example.js",
    "example-messaging": "npm run build && node dist/messaging-example.js",
    "example-getting-started": "npm run build && node dist/getting-started-example.js",
    "example-otel": "npm run build && node dist/otel-example.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node test/version.mjs && node test/public-api.mjs && node dist/provenance.test.js && node dist/incoming.test.js && node dist/http.test.js && node dist/reference-service.test.js && node dist/messaging.test.js && node dist/reference-messaging.test.js && node dist/logging.test.js && node dist/tracing.test.js && node dist/otel.test.js && node dist/otel.integration.test.js && node dist/storage.test.js && node dist/storage.contract.test.js && node test/conformance.test.mjs"
  },
  "keywords": [
    "provenance",
    "correlation",
    "causation"
  ],
  "author": "InGen",
  "license": "MIT",
  "devDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "typescript": "^5.5.4"
  }
}
