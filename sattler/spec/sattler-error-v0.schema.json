{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ingen.example/spec/sattler-error-v0.schema.json",
  "title": "InGen Sattler operation error",
  "description": "The compatibility-treated machine-readable failure envelope emitted by Sattler JSON-mode commands.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "operation", "errors"],
  "properties": {
    "schema": {"const": "ingen.sattler-error/v0"},
    "operation": {"type": "string", "minLength": 1},
    "errors": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/error-issue"}
    }
  },
  "$defs": {
    "error-issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "path": {"type": "string"},
        "message": {"type": "string", "minLength": 1}
      }
    }
  }
}
