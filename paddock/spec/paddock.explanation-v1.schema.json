{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ingen.example/spec/paddock.explanation-v1.schema.json",
  "title": "Paddock architecture explanation",
  "description": "Deterministic agent-facing explanation of a Paddock report.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source_schema",
    "status",
    "root",
    "module_path",
    "package_count",
    "edge_count",
    "triage",
    "summary",
    "findings"
  ],
  "properties": {
    "schema": {"const": "paddock.explanation/v1"},
    "source_schema": {"type": "string", "minLength": 1},
    "status": {"enum": ["PASS", "FAIL"]},
    "root": {"type": "string", "minLength": 1},
    "module_path": {"type": "string"},
    "package_count": {"type": "integer", "minimum": 0},
    "edge_count": {"type": "integer", "minimum": 0},
    "provenance": {"$ref": "#/$defs/provenance"},
    "baseline": {"$ref": "#/$defs/baseline-summary"},
    "waivers": {"type": "array", "items": {"$ref": "#/$defs/waiver-summary"}},
    "filter": {"$ref": "#/$defs/finding-filter"},
    "triage": {"$ref": "#/$defs/triage-summary"},
    "summary": {"type": "array", "items": {"$ref": "#/$defs/finding-summary"}},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding-explanation"}}
  },
  "$defs": {
    "file-reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_schema", "artifact_path", "artifact_sha256", "artifact_status", "artifact_exit_code", "created_at", "policy"],
      "properties": {
        "artifact_schema": {"const": "ingen.ci-result/v1"},
        "tool_version": {"type": "string", "minLength": 1},
        "artifact_path": {"type": "string", "minLength": 1},
        "artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "artifact_status": {"enum": ["passed", "failed", "error"]},
        "artifact_exit_code": {"type": "integer", "enum": [0, 1, 2]},
        "created_at": {"type": "string", "minLength": 1},
        "policy": {"$ref": "#/$defs/file-reference"},
        "policy_lock": {"$ref": "#/$defs/file-reference"},
        "graph": {"$ref": "#/$defs/file-reference"},
        "baseline": {"$ref": "#/$defs/file-reference"},
        "adapter": {"$ref": "#/$defs/adapter-reference"},
        "source_vcs": {"$ref": "#/$defs/vcs"}
      }
    },
    "vcs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "revision", "dirty"],
      "properties": {
        "system": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "dirty": {"type": "boolean"},
        "changes_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "adapter-reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["builtin", "external"]},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "executable": {"type": "string", "minLength": 1},
        "resolved_executable": {"type": "string", "minLength": 1},
        "executable_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "args_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "profile_path": {"type": "string", "minLength": 1},
        "profile_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "baseline-summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "entries", "matched"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "entries": {"type": "integer", "minimum": 0},
        "matched": {"type": "integer", "minimum": 0},
        "stale": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "waiver-summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "from", "owner", "expires", "status"],
      "properties": {
        "rule_id": {"type": "string", "minLength": 1},
        "from": {"type": "string", "minLength": 1},
        "to": {"type": "string"},
        "owner": {"type": "string", "minLength": 1},
        "expires": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "status": {"enum": ["applied", "expired", "unused", "unused-expired"]}
      }
    },
    "finding-filter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rule_id": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1}
      }
    },
    "triage-summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "findings", "active", "blocking", "accepted"],
      "properties": {
        "outcome": {"enum": ["remediate", "review", "accepted", "clear"]},
        "findings": {"type": "integer", "minimum": 0},
        "active": {"type": "integer", "minimum": 0},
        "blocking": {"type": "integer", "minimum": 0},
        "accepted": {"type": "integer", "minimum": 0}
      }
    },
    "finding-summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "kind", "severity", "findings", "active", "blocking", "waived", "baselined"],
      "properties": {
        "rule_id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "severity": {"enum": ["error", "warning", "info"]},
        "findings": {"type": "integer", "minimum": 0},
        "active": {"type": "integer", "minimum": 0},
        "blocking": {"type": "integer", "minimum": 0},
        "waived": {"type": "integer", "minimum": 0},
        "baselined": {"type": "integer", "minimum": 0}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "kind", "severity", "message"],
      "properties": {
        "rule_id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "severity": {"enum": ["error", "warning", "info"]},
        "from": {"type": "string"},
        "from_component": {"type": "string"},
        "from_labels": {"type": "object", "additionalProperties": {"type": "string"}},
        "to": {"type": "string"},
        "to_component": {"type": "string"},
        "to_labels": {"type": "object", "additionalProperties": {"type": "string"}},
        "file": {"type": "string"},
        "line": {"type": "integer", "minimum": 0},
        "message": {"type": "string", "minLength": 1},
        "waived": {"type": "boolean"},
        "waiver_reason": {"type": "string"},
        "waiver_owner": {"type": "string"},
        "waiver_expires": {"type": "string"},
        "waiver_status": {"type": "string"},
        "baselined": {"type": "boolean"},
        "baseline_fingerprint": {"type": "string"}
      }
    },
    "rule-summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "severity"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "severity": {"enum": ["error", "warning", "info"]},
        "from": {"type": "array", "items": {"type": "object", "additionalProperties": {"type": "string"}}},
        "to": {"type": "array", "items": {"type": "object", "additionalProperties": {"type": "string"}}},
        "allow": {"type": "array", "items": {"type": "string"}},
        "deny": {"type": "array", "items": {"type": "string"}},
        "allow_to": {"type": "array", "items": {"type": "string"}},
        "transitive": {"type": "boolean"},
        "direction": {"type": "string"},
        "context_label": {"type": "string"},
        "message": {"type": "string"}
      }
    },
    "finding-explanation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding", "status", "observation", "why", "suggested_actions"],
      "properties": {
        "finding": {"$ref": "#/$defs/finding"},
        "rule": {"$ref": "#/$defs/rule-summary"},
        "related_rules": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "status": {"enum": ["blocking", "advisory", "waived", "baselined", "expired-waiver"]},
        "observation": {"type": "string", "minLength": 1},
        "why": {"type": "string"},
        "suggested_actions": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
