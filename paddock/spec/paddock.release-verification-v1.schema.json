{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ingen.example/spec/paddock.release-verification-v1.schema.json",
  "title": "Paddock release verification result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "manifest", "directory", "version", "artifacts"],
  "properties": {
    "schema": {"const": "paddock.release-verification/v1"},
    "status": {"enum": ["PASS", "FAIL"]},
    "manifest": {"type": "string", "minLength": 1},
    "directory": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "expected_sha256", "status"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "expected_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "actual_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "status": {"enum": ["PASS", "FAIL"]},
          "error": {"type": "string"}
        }
      }
    }
  }
}
