        "labels": {
          "layer": "0",
          "role": "infrastructure"
        }
      },
      "lib-kernel": {
        "match": [
          "lib/kernel/**"
        ],
        "labels": {
          "layer": "0",
          "role": "shared"
        }
      },
      "lib-query": {
        "match": [
          "lib/query/**"
        ],
        "labels": {
          "layer": "2",
          "role": "runtime"
        }
      },
      "lib-root": {
        "match": [
          "lib/root/**"
        ],
        "labels": {
          "layer": "2",
          "role": "composition-support"
        }
      },
      "lib-runtime": {
        "match": [
          "lib/runtime/**"
        ],
        "labels": {
          "layer": "2",
          "role": "runtime"
        }
      },
      "lib-services": {
        "match": [
          "lib/services/**"
        ],
        "labels": {
          "layer": "1",
          "role": "application"
        }
      },
      "root": {
        "match": [
