        "id": "complete-classification",
        "kind": "coverage",
        "severity": "warning",
        "from": null,
        "to": null,
        "allow": null,
        "deny": null,
        "allow_to": null,
        "transitive": false,
        "direction": "",
        "context_label": "",
        "message": "Every source unit should have one reviewed component."
      },
      {
        "id": "layers-point-inward",
        "kind": "layer-direction",
        "severity": "error",
        "from": null,
        "to": null,
        "allow": null,
        "deny": null,
        "allow_to": null,
        "transitive": false,
        "direction": "toward-lower-layer",
        "context_label": "",
        "message": "UI dependencies should point toward lower layers."
      },
      {
        "id": "no-unresolved-imports",
        "kind": "unresolved",
        "severity": "warning",
        "from": null,
        "to": null,
        "allow": null,
        "deny": null,
        "allow_to": null,
        "transitive": false,
        "direction": "",
        "context_label": "",
        "message": "Relative and configured alias imports should resolve."
