        "labels": {
          "role": "unclassified"
        }
      },
      "styles": {
        "match": [
          "styles/**"
        ],
        "labels": {
          "layer": "3",
          "role": "presentation"
        }
      },
      "tests": {
        "match": [
          "tests/**"
        ],
        "labels": {
          "layer": "4",
          "role": "verification"
        }
      }
    },
    "rules": [
