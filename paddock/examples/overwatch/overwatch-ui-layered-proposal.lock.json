    "project": "overwatch-ui-layered-proposal",
    "source": {
      "language": "typescript",
      "roots": [
        "app",
        "components",
        "instrumentation.ts",
        "lib",
        "next-env.d.ts",
        "next.config.ts",
        "styles",
        "tests"
      ],
      "unit": "file"
    },
    "components": {
      "app-(app)": {
        "match": [
          "app/(app)/**"
        ],
        "labels": {
          "layer": "4",
          "role": "composition"
        }
      },
      "app-(auth)": {
        "match": [
          "app/(auth)/**"
        ],
        "labels": {
          "layer": "4",
          "role": "composition"
        }
      },
      "app-(dev)": {
        "match": [
          "app/(dev)/**"
        ],
        "labels": {
          "layer": "4",
          "role": "composition"
        }
      },
      "app-(marketing)": {
        "match": [
          "app/(marketing)/**"
        ],
        "labels": {
          "layer": "4",
          "role": "composition"
        }
      },
      "app-layout": {
        "match": [
          "app/layout.tsx"
        ],
        "labels": {
          "layer": "4",
          "role": "composition"
        }
      },
      "components": {
        "match": [
          "components/**"
        ],
        "labels": {
          "layer": "3",
          "role": "presentation"
        }
      },
      "lib-http": {
        "match": [
          "lib/http/**"
