{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ingen.example/spec/ingen.nublar-delivery-receipt-v1.schema.json",
  "title": "InGen Nublar Delivery Receipt v1",
  "description": "The result of one attempt to deliver a provider-neutral Nublar decision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "transport",
    "status",
    "attempted_at"
  ],
  "properties": {
    "schema": {
      "const": "ingen.nublar-delivery-receipt/v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "transport": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "accepted",
        "failed"
      ]
    },
    "http_status": {
      "type": "integer",
      "minimum": 100,
      "maximum": 599
    },
    "attempted_at": {
      "type": "string",
      "format": "date-time"
    },
    "error": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "accepted"
          }
        }
      },
      "then": {
        "required": [
          "http_status"
        ],
        "properties": {
          "http_status": {
            "minimum": 200,
            "maximum": 299
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        }
      },
      "then": {
        "required": [
          "error"
        ]
      }
    }
  ]
}
