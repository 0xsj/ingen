{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ingen.example/spec/ingen.hammond-review-policy-v1.schema.json",
  "title": "Hammond review policy",
  "description": "A versioned policy artifact that determines when a review cycle is approved.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "minimum_approvals"],
  "properties": {
    "schema": {"const": "ingen.hammond-review-policy/v1"},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "minimum_approvals": {"type": "integer", "minimum": 1},
    "required_roles": {
      "description": "Roles that must appear on approvals in the active review cycle.",
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "role_approval_thresholds": {
      "description": "Minimum distinct authorized actors required for each named role; entries imply required role coverage.",
      "type": "object",
      "propertyNames": {"minLength": 1},
      "additionalProperties": {"type": "integer", "minimum": 1}
    },
    "authority": {
      "description": "Versioned actor-to-role authority snapshot used by local policy evaluation.",
      "$ref": "#/$defs/authority-reference"
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "sha256"],
      "properties": {
        "uri": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "authority-reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "schema", "artifact"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "integer", "minimum": 1},
        "schema": {"const": "ingen.hammond-authority/v1"},
        "artifact": {"$ref": "#/$defs/artifact"}
      }
    }
  }
}
