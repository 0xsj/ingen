{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ingen.example/spec/ingen.hammond-authority-v1.schema.json",
  "title": "Hammond local role authority",
  "description": "A versioned actor-to-role authority snapshot for local policy evaluation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "actors"],
  "properties": {
    "schema": {"const": "ingen.hammond-authority/v1"},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "actors": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"type": "string", "minLength": 1}
      }
    },
    "signature": {
      "description": "Optional issuer signature over the canonical authority payload without this signature property.",
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "signature"],
      "properties": {
        "algorithm": {"const": "ed25519"},
        "key_id": {"type": "string", "minLength": 1},
        "signature": {"type": "string", "minLength": 1}
      }
    }
  }
}
