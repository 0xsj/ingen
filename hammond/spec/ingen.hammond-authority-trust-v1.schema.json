{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ingen.example/spec/ingen.hammond-authority-trust-v1.schema.json",
  "title": "Hammond authority trust snapshot",
  "description": "A versioned caller-owned set of public keys used to verify authority artifact signatures.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "keys"],
  "properties": {
    "schema": {"const": "ingen.hammond-authority-trust/v1"},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "algorithm", "public_key", "status"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "algorithm": {"const": "ed25519"},
          "public_key": {"type": "string", "pattern": "^[A-Za-z0-9+/]{43}=$"},
          "status": {"enum": ["active", "revoked"]}
        }
      }
    },
    "signature": {
      "description": "Optional root signature over the canonical trust payload without this signature property.",
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "signature"],
      "properties": {
        "algorithm": {"const": "ed25519"},
        "key_id": {"type": "string", "minLength": 1},
        "signature": {"type": "string", "minLength": 1}
      }
    }
  }
}
